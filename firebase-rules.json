{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "roomReactions": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "roomCursors": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "roomMasterTraceLive": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "roomStudentSnapshots": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "teacherAccounts": {
      ".read": "auth != null",
      "$accountId": {
        ".write": "auth != null"
      }
    },
    "teacherLibraries": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "teacherVocabBanks": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "classCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['t','s','tm','c']) && $code.matches(/^[A-Z0-9]{4,10}$/)"
      }
    },
    "capsuleLinks": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "capsuleLinkOwners": {
      "$linkId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "capsuleMarks": {
      "$linkId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "classStories": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "relayStories": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "classLinkOwners": {
      "$linkId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "relayLinkOwners": {
      "$linkId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "teacherPlatform": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "hwFiles": {
          "$classId": {
            "$hwId": {
              "$studentKey": {
                "$i": {
                  ".validate": "newData.isString() && newData.val().length < 900000"
                }
              }
            }
          }
        },
        "recordShots": {
          "$recordId": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length < 900000"
            }
          }
        },
        "homework": {
          "$classId": {
            "items": {
              "$hwId": {
                "imgs": {
                  "$i": {
                    ".validate": "newData.isString() && newData.val().length < 900000"
                  }
                },
                "title": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                }
              }
            },
            "comments": {
              "$itemId": {
                "$commentId": {
                  "text": {
                    ".validate": "newData.isString() && newData.val().length <= 2000"
                  }
                }
              }
            }
          }
        },
        "hwSubs": {
          "$classId": {
            "$hwId": {
              "$studentKey": {
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 8000"
                }
              }
            }
          }
        },
        "leave": {
          "$classId": {
            "$leaveId": {
              "reason": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              }
            }
          }
        }
      }
    },
    "liveGames": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/owner').val() == auth.uid) || data.child('meta/owner').val() == auth.uid || (data.exists() && !newData.exists() && data.child('meta/exp').val() < now))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && !data.child('kicked').exists() && !newData.child('kicked').exists() && root.child('liveGames/'+$code+'/meta').exists()",
            ".validate": "newData.hasChildren(['name','at']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('liveGames/'+$code+'/players/'+$uid+'/name').exists() && !root.child('liveGames/'+$code+'/players/'+$uid+'/kicked').exists()"
          }
        }
      }
    }
  }
}
